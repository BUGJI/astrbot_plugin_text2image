{
  "default_font": {
    "description": "默认字体名称",
    "hint": "填入 fonts 目录下字体文件名（不带扩展名），如 simsun.ttf 则填 simsun",
    "type": "string",
    "default": "宋体2"
  },
  "limit": {
    "description": "限制设置",
    "type": "object",
    "items": {
      "max_images_per_task": {
        "description": "单次任务最大图片数",
        "type": "int",
        "default": 1000
      },
      "max_chars_per_task": {
        "description": "单次任务最大字符数",
        "type": "int",
        "default": 20000
      },
      "max_task": {
        "description": "队列最大任务数",
        "type": "int",
        "default": 4
      },
      "fonts_per_page": {
        "description": "每页显示字体数量",
        "type": "int",
        "default": 20
      },
      "font_list_columns": {
        "description": "字体列表每行显示的字体数量",
        "hint": "控制 texttool listall 每行显示多少个字体预览，小于 1 设为 1，大于每页数量则设为每页数量",
        "type": "int",
        "default": 3
      },
      "max_concurrent_renders": {
        "description": "单次任务内最大并发渲染数",
        "hint": "控制单个任务内同时渲染的图片数量，增大可提升速度但增加资源占用",
        "type": "int",
        "default": 8
      },
      "max_concurrent_font_samples": {
        "description": "字体示例图渲染并发数",
        "hint": "控制 texttool listall 命令同时渲染的字体示例数量，增大可提升缓存生成速度但增加资源占用",
        "type": "int",
        "default": 8
      }
    }
  },
  "compatibility": {
    "description": "兼容性设置",
    "type": "object",
    "items": {
      "single_image_send_by_file": {
        "description": "单图以文件方式发送",
        "type": "bool",
        "default": false
      },
      "list_menu_image_send_mode": {
        "description": "list 命令菜单图片发送模式",
        "type": "string",
        "options": ["text", "image", "file", "zipfile"],
        "default": "text"
      },
      "listall_menu_image_send_mode": {
        "description": "listall 命令菜单图片发送模式",
        "type": "string",
        "options": ["image", "file", "zipfile"],
        "default": "image"
      },
      "blacklist": {
        "description": "黑名单群号列表",
        "type": "list",
        "default": []
      },
      "blacklist_notice": {
        "description": "黑名单提示",
        "type": "string",
        "default": "当前群暂不支持此功能。"
      }
    }
  }
}
